# Copy to .env and adjust. Real environment variables override this file.

# Runtime environment label (default: development)
APP_ENV=development

# HTTP listen port (default: 8080)
PORT=8080

# PostgreSQL connection string (required). Under `make docker-up` the server
# container ignores this and talks to the `db` service directly.
DATABASE_URL=postgres://alphahack:alphahack@localhost:5432/alphahack?sslmode=disable

# Model provider: anthropic, ollama or fake (default: anthropic if ANTHROPIC_API_KEY is set, else fake; ollama is never a default)
AI_PROVIDER=

# Anthropic API key (required when AI_PROVIDER is anthropic)
ANTHROPIC_API_KEY=

# Anthropic model id (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort: "", low, medium, high, xhigh or max (default: empty)
ANTHROPIC_EFFORT=

# Server-side refusal fallbacks: if the model declines a request, Anthropic
# re-serves it on a fallback model in the same call (default: true). Only sent
# for models that support it. Set to false if the API rejects the field.
AI_FALLBACKS=true

# Max output tokens per model call (default: 16000, must be > 0)
AI_MAX_TOKENS=16000

# Max tool-use loop iterations per run (default: 10, must be > 0)
AI_MAX_ITERATIONS=10

# Messages of history sent to the model per turn (default: 40, must be > 0)
AI_HISTORY_LIMIT=40

# Ollama (local models)

# Ollama server URL, http or https (default: http://localhost:11434).
# Under `make docker-up` this is ignored: the container always uses
# http://host.docker.internal:11434 (override with DOCKER_OLLAMA_BASE_URL).
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (default: qwen3.5:35b-a3b)
OLLAMA_MODEL=qwen3.5:35b-a3b

# Thinking mode: "", true or false (default: empty = model default)
OLLAMA_THINK=

# Context window in tokens; 0 uses Ollama's own default, which can be as small
# as 4096 and silently truncates long prompts. Use 16384 or more for agents with
# tools (default: 0)
OLLAMA_NUM_CTX=0

# Per-request deadline as a Go duration (default: 300s)
REQUEST_TIMEOUT=300s

# Comma-separated allowed CORS origins (default: *)
CORS_ALLOWED_ORIGINS=*

# Log level: debug, info, warn or error (default: info)
LOG_LEVEL=info
